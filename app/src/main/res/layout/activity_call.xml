<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B141A">

    <io.livekit.android.renderer.SurfaceViewRenderer
        android:id="@+id/remote_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/audio_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="150dp">

        <TextView
            android:id="@+id/avatar"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_call_avatar"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/peer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textColor="#FFFFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <io.livekit.android.renderer.SurfaceViewRenderer
        android:id="@+id/local_video"
        android:layout_width="104dp"
        android:layout_height="156dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="40dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/top_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/top_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/active_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/btn_mute_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_mute"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_call_round"
                    android:gravity="center"
                    android:text="🎤"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/btn_mute_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="মিউট"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_speaker_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_speaker"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_call_round"
                    android:gravity="center"
                    android:text="🔊"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/btn_speaker_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="স্পিকার"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_camera_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_camera"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_call_round"
                    android:gravity="center"
                    android:text="🎥"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/btn_camera_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ক্যামেরা"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_end_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_end"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_call_end"
                    android:gravity="center"
                    android:text="✕"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/btn_end_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="শেষ"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/incoming_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        android:orientation="horizontal"
        android:visibility="gone">
            <LinearLayout
                android:id="@+id/btn_decline_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_decline"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_call_end"
                    android:gravity="center"
                    android:text="✕"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/btn_decline_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="কাটুন"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_accept_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_accept"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_call_accept"
                    android:gravity="center"
                    android:text="📞"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/btn_accept_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ধরুন"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
    </LinearLayout>
</FrameLayout>
